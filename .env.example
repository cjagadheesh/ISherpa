# Root .env for `docker compose up`. Copy this file to `.env` in the repo
# root (same directory as docker-compose.yml) — Compose reads it
# automatically for variable substitution below. Every var has a safe
# default baked into docker-compose.yml, so `docker compose up` works with
# zero setup (offline/demo mode); fill these in only for live LLM,
# Supabase-backed workspaces, or blockchain anchoring.

# ── Deploying somewhere other than localhost (EC2, any cloud VM, etc.) ──────
# Both default to localhost, which only works when your browser and the
# containers are on the same machine. Set these to your host's public
# DNS/IP or nothing will be reachable from outside the VM.
#   VITE_API_URL  — baked into the frontend JS bundle at *build* time; must
#                   be the address your BROWSER can reach the backend at.
#                   Changing it requires `docker compose up --build`, not
#                   just a restart.
#   CORS_ORIGINS  — the backend's allowlist; must include the exact origin
#                   (scheme + host + port) the frontend is actually served
#                   from, or the browser's requests get rejected by CORS.
# Example for an EC2 instance with public DNS ec2-1-2-3-4.compute.amazonaws.com:
#   VITE_API_URL=http://ec2-1-2-3-4.compute.amazonaws.com:8000
#   CORS_ORIGINS=http://ec2-1-2-3-4.compute.amazonaws.com:5173
# Also make sure the instance's Security Group allows inbound TCP on 8000
# and 5173 — a correct URL still won't connect through a closed port.
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── LLM provider (backend/llm_client.py) ─────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
# Optional additional Groq keys — GROQ_API_KEY_2, _3, ... — pool round-robin
# across concurrent calls (not just failover), stretching a limited free-tier
# daily quota across accounts and cutting wall-clock time on batch uploads.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Blockchain anchoring (Polygon Amoy Testnet) — optional, mocks if unset ──
POLYGON_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_MAX_RETRIES=1
BLOCKCHAIN_RETRY_BACKOFF_SECONDS=2

# ── Supabase (per-user saved workspaces) — optional, falls back to local
# session storage inside the container if unset ─────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Frontend build-time vars (baked into the JS bundle by Vite, not read at
# container runtime) — same optional-Supabase fallback applies ─────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
