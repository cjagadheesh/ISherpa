# ── LLM provider (backend/llm_client.py) ─────────────────────────────────────
# LLM_PROVIDER selects the active provider: groq | openai | anthropic | ollama
# Switching providers is a config change only — no code changes needed.
LLM_PROVIDER=groq
# Optional: override the default model for the selected provider.
# Defaults: groq=llama-3.3-70b-versatile, openai=gpt-4o-mini,
#           anthropic=claude-sonnet-4-5, ollama=llama3.1:8b-instruct
LLM_MODEL=

# Set only when you explicitly choose third-party Groq processing.
GROQ_API_KEY=
# Optional additional Groq keys — GROQ_API_KEY_2, _3, ... (or a comma-separated
# GROQ_API_KEYS) — add more keys to a round-robin pool. Every complete() call
# picks the next key in rotation (not just on failure), so concurrent calls —
# e.g. uploading several documents at once — spread across keys instead of
# serializing behind one. A rate-limited call retries on the remaining keys in
# the pool. Useful for stretching a limited free-tier daily quota across
# several accounts and cutting wall-clock time on batch uploads.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Required only if LLM_PROVIDER=openai.
OPENAI_API_KEY=
# Required only if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Used only if LLM_PROVIDER=ollama. No API key needed for a local server.
OLLAMA_BASE_URL=http://localhost:11434/v1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
PORT=8000

# ── Blockchain anchoring retry behaviour (backend/blockchain.py) ────────────
# Default is 1 attempt (no retry) — anchoring is best-effort on top of the
# core upload/extraction flow, so a flaky free-tier RPC shouldn't add delay
# to it. Raise this only if you're on a more reliable (e.g. paid) RPC endpoint.
BLOCKCHAIN_MAX_RETRIES=1
BLOCKCHAIN_RETRY_BACKOFF_SECONDS=2

# Supabase backend settings. Never expose SUPABASE_SERVICE_ROLE_KEY to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
