# Blacklist approach: copy everything by default, exclude only what must
# never be baked into the image. A whitelist here goes stale every time a
# new backend module is added (main.py imports 20+ local modules — a
# whitelist previously missed 15 of them, which would crash the container
# on startup with ImportError). Excluding secrets/caches/local-state is a
# much smaller, more stable list to maintain than every source file.

# Secrets — never bake these into an image
.env
.env.*
!.env.example

# Local runtime state / caches — regenerated at runtime, not part of the image
__pycache__/
*.pyc
.venv/
venv/
temp_uploads/
audit/
chroma_db/
session_state.json
*.docx
*.pdf

# Dev-only
tests/
.pytest_cache/
.git/
.gitignore
